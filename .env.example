# Copy to .env and fill in the two API keys. Never commit .env.
#   cp .env.example .env
# Comments stay on their own lines (some .env parsers mishandle inline comments).

# ---------------- secrets ----------------
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LangSmith key: https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=
# local database password
POSTGRES_PASSWORD=postgres

# ---------------- LLM (LiteLLM names: gemini/<model>) ----------------
# `make smoke` lists the Gemini models your key can use. Update these if needed.
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini/gemini-3.1-flash-lite
LLM_JUDGE_MODEL=gemini/gemini-3.5-flash

# ---------------- LangSmith tracing ----------------
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=readmission-outreach
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------- image versions ----------------
AIRFLOW_VERSION=3.1.0
AIRFLOW_UID=50000
MAILPIT_IMAGE=axllent/mailpit:v1.20.0

# ---------------- service addresses as seen from YOUR LAPTOP ----------------
# Inside Docker, docker-compose.yml overrides these with service names.
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=app
APP_DB_USER=postgres
MLFLOW_TRACKING_URI=http://localhost:5000
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025
AIRFLOW_API_URL=http://localhost:8080
